<?php

declare(strict_types=1);

/**
 * @file
 * Install and update hooks for the GPC module.
 */

/**
 * Install the Component entity schema for existing sites.
 */
function gpc_update_10001(): void {
  /** @var \Drupal\Core\Entity\EntityDefinitionUpdateManagerInterface $update_manager */
  $update_manager = \Drupal::service('entity.definition_update_manager');
  $change_list = $update_manager->getChangeList();

  if (empty($change_list['gpc_component']['entity_type'])) {
    return;
  }

  $entity_type = $update_manager->getEntityType('gpc_component');
  if ($entity_type === NULL) {
    return;
  }

  $field_storage_definitions = \Drupal::service('entity_field.manager')->getFieldStorageDefinitions('gpc_component');
  $update_manager->installFieldableEntityType($entity_type, $field_storage_definitions);
}

