{#
/**
 * @file
 * Drawer-specific menu rendering for the GPC app shell.
 */
#}
{% import _self as menus %}

{{ menus.menu_links(items, attributes, 0) }}

{% macro menu_links(items, attributes, menu_level) %}
  {% import _self as menus %}
  {% if items %}
    {% if menu_level == 0 %}
      <ul{{ attributes.addClass('gpc-menu', 'gpc-menu--drawer', 'gpc-menu--level-0') }}>
    {% else %}
      <ul class="gpc-menu gpc-menu--drawer gpc-menu--subtree gpc-menu--level-{{ menu_level }}">
    {% endif %}
    {% for item in items %}
      {% set item_classes = [
        'menu-item',
        'gpc-menu__item',
        'gpc-menu__item--level-' ~ menu_level,
        item.is_expanded ? 'menu-item--expanded',
        item.is_collapsed ? 'menu-item--collapsed',
        item.in_active_trail ? 'menu-item--active-trail',
      ] %}
      <li{{ item.attributes.addClass(item_classes) }}>
        {{ link(item.title, item.url, { class: ['gpc-menu__link', 'gpc-menu__link--level-' ~ menu_level] }) }}
        {% if item.below %}
          {{ menus.menu_links(item.below, attributes, menu_level + 1) }}
        {% endif %}
      </li>
    {% endfor %}
      </ul>
  {% endif %}
{% endmacro %}
