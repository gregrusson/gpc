<?php

declare(strict_types=1);

use Drupal\Core\Cache\Cache;
use Drupal\Core\Template\Attribute;

/**
 * @file
 * Theme hooks for GPC Theme.
 */

/**
 * Adds the GPC page suggestion for app routes.
 */
function gpc_theme_theme_suggestions_page_alter(array &$suggestions, array $variables): void {
  if (gpc_theme_is_gpc_path()) {
    $suggestions[] = 'page__gpc';
  }
}

/**
 * Prepares HTML template variables.
 */
function gpc_theme_preprocess_html(array &$variables): void {
  $attributes = $variables['attributes'] ?? [];
  if (!$attributes instanceof Attribute) {
    $attributes = new Attribute(is_array($attributes) ? $attributes : []);
  }
  $attributes->addClass('gpc-site');
  $variables['attributes'] = $attributes;
}

/**
 * Prepares page template variables.
 */
function gpc_theme_preprocess_page(array &$variables): void {
  $site_config = \Drupal::config('system.site');
  $variables['site_name'] = (string) $site_config->get('name');
  $variables['site_slogan'] = (string) $site_config->get('slogan');
  $variables['gpc_drawer_id'] = 'gpc-drawer';
  $variables['gpc_drawer_menu'] = gpc_theme_build_menu_tree('main', ['gpc-menu', 'gpc-menu--drawer']);
  $variables['gpc_account_menu'] = gpc_theme_build_account_menu();
  $variables['is_gpc_route'] = gpc_theme_is_gpc_path();
  $variables['has_drawer'] = !empty($variables['gpc_drawer_menu']['#items']);
  $variables['has_account_menu'] = !empty($variables['gpc_account_menu']['menu']['#items']);

  $variables['page']['#cache']['tags'] = Cache::mergeTags(
    $variables['page']['#cache']['tags'] ?? [],
    ['config:system.site']
  );
  $variables['page']['#cache']['contexts'] = Cache::mergeContexts(
    $variables['page']['#cache']['contexts'] ?? [],
    ['user']
  );
}

/**
 * Determines whether the current request is inside the GPC app area.
 */
function gpc_theme_is_gpc_path(): bool {
  $request = \Drupal::requestStack()->getCurrentRequest();
  return $request !== null && str_starts_with($request->getPathInfo(), '/gpc');
}

/**
 * Builds a rendered menu tree with consistent theme classes.
 */
function gpc_theme_build_menu_tree(string $menu_name, array $classes = []): array {
  $menu_tree = \Drupal::menuTree();
  $parameters = $menu_tree->getCurrentRouteMenuTreeParameters($menu_name);
  $tree = $menu_tree->load($menu_name, $parameters);
  $tree = $menu_tree->transform($tree, [
    ['callable' => 'menu.default_tree_manipulators:checkAccess'],
    ['callable' => 'menu.default_tree_manipulators:generateIndexAndSort'],
  ]);

  $build = $menu_tree->build($tree);
  $build['#attributes']['class'] = array_values(array_unique(array_merge($build['#attributes']['class'] ?? [], $classes)));

  return $build;
}

/**
 * Builds account menu variables for the header.
 */
function gpc_theme_build_account_menu(): array {
  $account = \Drupal::currentUser();
  $authenticated = $account->isAuthenticated();
  $label = $authenticated ? $account->getDisplayName() : t('Account');
  $subtitle = $authenticated ? t('My account') : t('Log in or register');

  return [
    'label' => $label,
    'subtitle' => $subtitle,
    'authenticated' => $authenticated,
    'trigger_label' => t('Account menu'),
    'menu' => gpc_theme_build_menu_tree('account', ['gpc-menu', 'gpc-menu--account']),
  ];
}
