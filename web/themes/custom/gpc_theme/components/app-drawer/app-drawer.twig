<aside
  id="{{ drawer_id }}"
  class="gpc-app-drawer"
  data-drawer
  data-open="false"
  role="navigation"
  aria-label="{{ 'Main navigation'|t }}"
  aria-hidden="true"
>
  <div class="gpc-app-drawer__panel">
    <div class="gpc-app-drawer__header">
      <button
        class="gpc-app-drawer__close"
        type="button"
        data-drawer-close
        data-drawer-target="{{ drawer_id }}"
        aria-label="{{ 'Close navigation'|t }}"
      >
        <span aria-hidden="true">×</span>
      </button>
    </div>

    <div class="gpc-app-drawer__content">
      <div class="gpc-app-drawer__main">
        {{ content }}
      </div>

      {% if utility %}
        <div class="gpc-app-drawer__utility">
          {{ utility }}
        </div>
      {% endif %}
    </div>
  </div>
</aside>
