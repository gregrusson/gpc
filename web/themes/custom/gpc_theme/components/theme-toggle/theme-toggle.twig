<button
  class="gpc-theme-toggle"
  type="button"
  data-theme-toggle
  aria-label="{{ label|default('Switch to dark mode') }}"
  aria-pressed="false"
  title="{{ label|default('Switch to dark mode') }}"
>
  <span class="gpc-theme-toggle__icon gpc-theme-toggle__icon--sun" aria-hidden="true">
    <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true" class="gpc-theme-toggle__svg">
      <circle cx="12" cy="12" r="4.5" fill="none" stroke="currentColor" stroke-width="1.8"/>
      <path d="M12 2.5v3M12 18.5v3M4.6 4.6l2.1 2.1M17.3 17.3l2.1 2.1M2.5 12h3M18.5 12h3M4.6 19.4l2.1-2.1M17.3 6.7l2.1-2.1" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
    </svg>
  </span>
  <span class="gpc-theme-toggle__icon gpc-theme-toggle__icon--moon" aria-hidden="true">
    <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true" class="gpc-theme-toggle__svg">
      <path d="M14.5 3.5a8.5 8.5 0 1 0 6 14.5A9.5 9.5 0 0 1 14.5 3.5Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
    </svg>
  </span>
  {% if show_label %}
    <span class="gpc-theme-toggle__label">{{ label|default('Switch to dark mode') }}</span>
  {% endif %}
</button>
