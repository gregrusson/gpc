{% set classes = 'gpc-button gpc-button--' ~ variant|default('secondary') ~ ' gpc-button--' ~ size|default('md') %}
{% if block %}
  {% set classes = classes ~ ' gpc-button--block' %}
{% endif %}
{% if href and not disabled %}
  <a
    href="{{ href }}"
    class="{{ classes }}"
    {% if target %}target="{{ target }}"{% endif %}
    {% if rel %}rel="{{ rel }}"{% endif %}
    {% if aria_label %}aria-label="{{ aria_label }}"{% endif %}
  >
    {{ label }}
  </a>
{% else %}
  <button
    type="{{ type|default('button') }}"
    class="{{ classes }}"
    {% if disabled %}disabled{% endif %}
    {% if aria_label %}aria-label="{{ aria_label }}"{% endif %}
  >
    {{ label }}
  </button>
{% endif %}
